GROQ_API_KEY=your-groq-api-key-here
# Optional model override (default: qwen/qwen3.8-27b; also supports: openai/gpt-oss-120b, openai/gpt-oss-20b)
GROQ_MODEL=qwen/qwen3.8-27b

# Optional Kaggle credentials (for automated dataset download via kagglehub)
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key

